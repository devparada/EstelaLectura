---
interface Props {
  title: string;
}

const { title } = Astro.props;
import "../styles/global.css";
import Cabecera from "../components/Cabecera.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Una librería donde se muestran libros de diversos temas"
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="logo.png" />
    <title>{title}</title>
  </head>
  <body>
    <Cabecera />
    <slot />
  </body>
  <style is:global>
    :root {
      --accent: 136, 58, 234;
      --accent-light: #83a7e2;
      --accent-dark: 49, 10, 101;
    }
    * {
      margin: 0;
      padding: 0;
    }
    html {
      font-family: system-ui, sans-serif;
    }
    main {
      margin: auto;
      padding: 0.5rem;
      max-width: calc(100% - 2rem);
      color: white;
      line-height: 1.6;
    }
    nav div {
      display: flex;
      align-items: center;
      justify-content: space-around;
      color: white;
    }
  </style>
</html>
