---
interface Props {
  title: string;
  autor: string;
  body: string;
  href: string;
  src: string;
}

const { href, title, autor, body, src } = Astro.props;
import { Image } from "astro:assets";
---

<li class="link-card">
  <div>
    <a href={href}>
      <Image
        src={src}
        alt=`Logo ${title}`
        width="80"
        height="80"
        loading="eager"
        class="w-full"
      />
      <div class="text-left w-full mt-2! mb-1!">
        <h2>{title}</h2>
        <p>{autor}</p>
      </div>
      <p class="mt-2 text-left">{body}</p>
    </a>
    <div class="text-center mb-2.5!">
      <button class="bg-blue-600 rounded-2xl py-1.5! cursor-pointer w-full"
        >Marcar como leído</button
      >
    </div>
  </div>
</li>
<style>
  h2 {
    font-size: 17px;
    font-weight: bold;
  }
  .link-card {
    width: 100%;
    line-height: 1.4;
    border-radius: 12px;
    opacity: 0.9;
    display: flex;
    padding: 1px;
    border-radius: 10px;
    transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  .link-card div {
    margin-top: 20px;
    margin-bottom: 20px;
  }
  .link-card div a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .link-card:is(:hover) h2 {
    color: var(--accent-light);
  }
</style>
